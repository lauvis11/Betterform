---
import { Play, ArrowRight } from "lucide-astro";
import type { Exercise } from "../types/exercise";
import youtubeIcon from "../assets/icons/youtube-svgrepo-com.svg";

export interface Props {
  exercise: Exercise;
}

const { exercise } = Astro.props;

// Fondos con sutil gradiente temático según categoría
const categoryGradients: Record<string, string> = {
  Pecho: "from-red-950/40 via-dark-900 to-dark-950",
  Piernas: "from-emerald-950/40 via-dark-900 to-dark-950",
  Espalda: "from-blue-950/40 via-dark-900 to-dark-950",
  Hombros: "from-amber-950/40 via-dark-900 to-dark-950",
  Brazos: "from-purple-950/40 via-dark-900 to-dark-950",
  Core: "from-cyan-950/40 via-dark-900 to-dark-950",
};

const gradientClass = categoryGradients[exercise.category] || "from-dark-900 via-dark-850 to-dark-950";
---

<a
  href={`/exercises/${exercise.id}`}
  class="group relative flex flex-col bg-dark-800 border border-dark-700/80 hover:border-brand-red rounded-xl overflow-hidden transition-colors duration-200 shadow-md cursor-pointer"
>
  <!-- Frame superior de Video / Preview (aspecto 4:3 para dar formato ecommerce cuadrado) -->
  <div class="relative w-full aspect-4/3 bg-dark-950 border-b border-dark-700/60 overflow-hidden flex items-center justify-center">
    <div class={`absolute inset-0 bg-linear-to-br ${gradientClass}`}></div>

    <!-- Patrón de malla de fondo sutil para dar textura deportiva -->
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] bg-size-[12px_12px]"></div>

    <!-- Botón Play central estático (sin hover animations) -->
    <div class="relative z-10 w-12 h-12 rounded-full bg-dark-900/90 border border-dark-700 flex items-center justify-center text-white shadow-lg">
      <Play class="w-5 h-5 fill-current ml-0.5 text-white" />
    </div>

    <!-- Badge de Tipo de video (esquina inferior derecha) -->
    {exercise.video_type && (
      <div class="absolute bottom-2 right-2 z-10 px-1.5 py-0.5 bg-black/80 backdrop-blur-xs text-neutral-300 font-mono text-[9px] rounded uppercase font-semibold tracking-wider border border-white/5">
        {exercise.video_type}
      </div>
    )}
  </div>

  <!-- Contenido inferior estilo eCommerce -->
  <div class="p-4 flex flex-col justify-between flex-1 gap-3">
    <div>
      <!-- Etiquetas: Categoría desplazada aquí y equipamiento -->
      <div class="mb-1.5 flex items-center gap-1.5 flex-wrap">
        <span class="inline-flex items-center px-2 py-0.5 rounded-sm bg-brand-red text-white text-[10px] font-bold tracking-wider">
          {exercise.category}
        </span>
        <span class="text-neutral-500 select-none text-[10px]">-</span>
        <span class="inline-flex items-center px-2 py-0.5 rounded bg-dark-700/60 border border-dark-600/60 text-neutral-300 text-[10px] font-medium capitalize">
          {exercise.equipment}
        </span>
      </div>

      <!-- Nombre del ejercicio -->
      <h3 class="text-base font-bold text-white line-clamp-1 leading-snug">
        {exercise.name}
      </h3>

      <!-- Breve snippet de instrucciones -->
      {exercise.instructions && (
        <p class="text-xs text-neutral-400 line-clamp-2 mt-1.5 leading-relaxed">
          {exercise.instructions}
        </p>
      )}
    </div>

    <!-- Footer de la tarjeta: Canal de YouTube y CTA de técnica -->
    <div class="pt-2.5 border-t border-dark-700/60 flex items-center justify-between text-xs">
      <div class="flex items-center gap-1.5 min-w-0 pr-2">
        <img
          src={typeof youtubeIcon === 'string' ? youtubeIcon : (youtubeIcon as any).src}
          alt="YouTube"
          class="w-3.5 h-3.5 shrink-0 brightness-0 invert"
        />
        <span class="text-white font-medium truncate text-[11px]">
          {exercise.channel.name}
        </span>
      </div>

      <div class="inline-flex items-center gap-1 text-brand-red font-semibold text-[11px] shrink-0">
        <span>Ver</span>
        <ArrowRight class="w-3 h-3" />
      </div>
    </div>
  </div>
</a>
