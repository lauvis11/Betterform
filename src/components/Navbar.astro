---
import { Image } from 'astro:assets';
import BetterFormLogo from '../assets/Betterform-logo-removebg-preview.png';
import { House, Dumbbell, CircleAlert } from '@lucide/astro';

interface NavItem {
  title: string;
  href: string;
  icon: typeof House;
}

const navitems: NavItem[] = [
  { title: 'Inicio', href: '/', icon: House },
  { title: 'Ejercicios', href: '/exercises', icon: Dumbbell },
  { title: 'Información', href: '/about', icon: CircleAlert }
];

const currentPath = Astro.url.pathname;

const isItemActive = (href: string) => {
  if (href === '/' || href === '/inicio') {
    return currentPath === '/' || currentPath === '/inicio';
  }
  if (href === '/exercises' || href === '/ejercicios') {
    return currentPath.startsWith('/exercises') || currentPath.startsWith('/ejercicios');
  }
  if (href === '/about' || href === '/informacion') {
    return currentPath.startsWith('/about') || currentPath.startsWith('/informacion');
  }
  return currentPath === href;
};
---

<header class="sticky top-0 left-0 right-0 z-50 w-full bg-dark-900/90 backdrop-blur-md border-b border-dark-700">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 h-18 sm:h-20 flex items-center justify-between">
    <div class="flex items-center">
      <a 
        href="/" 
        class="flex items-center -ml-2 sm:-ml-3 focus:outline-none focus-visible:ring-1 focus-visible:ring-brand-red rounded"
        aria-label="BetterForm - Inicio"
      >
        <Image 
          src={BetterFormLogo} 
          alt="BetterForm Logo" 
          class="h-12 sm:h-14 md:h-16 w-auto object-contain"
          loading="eager"
        />
      </a>
    </div>

    <!-- Navegación Desktop -->
    <nav class="hidden md:flex h-full items-center" aria-label="Navegación principal">
      <ul class="flex h-full items-center gap-1 sm:gap-2">
        {
          navitems.map((item) => {
            const active = isItemActive(item.href);
            const Icon = item.icon;
            return (
              <li class="h-full flex items-center">
                <a
                  href={item.href}
                  class={`h-full flex items-center gap-2 px-3.5 text-sm font-medium transition-colors duration-150 ${
                    active
                      ? 'text-brand-red'
                      : 'text-white hover:text-brand-red'
                  }`}
                  aria-current={active ? 'page' : undefined}
                >
                  <Icon class="w-4 h-4 shrink-0" />
                  <span>{item.title}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Botón Menú Mobile -->
    <button
      id="navbar-toggle-btn"
      type="button"
      class="md:hidden flex items-center justify-center p-2 rounded text-white hover:bg-dark-800 border border-transparent hover:border-dark-700 transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-brand-red"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Alternar menú de navegación"
    >
      <svg id="icon-menu" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Menú desplegable Mobile -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-dark-700 bg-dark-900/98 px-4 py-3 space-y-1">
    <ul class="flex flex-col gap-1">
      {
        navitems.map((item) => {
          const active = isItemActive(item.href);
          const Icon = item.icon;
          return (
            <li>
              <a
                href={item.href}
                class={`flex items-center gap-2.5 px-3 py-2.5 rounded text-sm font-medium transition-all duration-150 ${
                  active
                    ? 'text-brand-red bg-dark-800'
                    : 'text-white hover:text-brand-red hover:bg-dark-800/60'
                }`}
                aria-current={active ? 'page' : undefined}
              >
                <Icon class="w-4 h-4 shrink-0" />
                <span>{item.title}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('navbar-toggle-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  if (toggleBtn && mobileMenu && iconMenu && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      iconMenu.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>