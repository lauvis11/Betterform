---
import Layout from "../layout/Layout.astro";
import { ArrowLeft } from "lucide-astro";
---

<Layout>
  <main class="flex-1 w-full flex items-center justify-center px-6 py-12 sm:py-20 min-h-[calc(100vh-12rem)]">
    <div class="w-full max-w-120 text-center flex flex-col items-center">
      {/* 2. Código de error gigante */}
      <h1 class="text-8xl sm:text-9xl font-semibold tracking-tight text-brand-red leading-none select-none">
        404
      </h1>

      {/* 3. Título */}
      <h2 class="text-2xl sm:text-3xl font-bold text-white mt-4 tracking-tight">
        Página no encontrada
      </h2>

      {/* 4. Descripción */}
      <p class="text-base text-neutral-400 leading-relaxed mt-3 mb-8 max-w-100">
        La página que buscas no existe o el ejercicio fue movido.
      </p>

      {/* 5. Botón de acción principal */}
      <a
        href="/"
        class="inline-flex items-center justify-center gap-2 bg-brand-red text-white font-semibold text-sm px-8 py-3.5 rounded-xl hover:brightness-110 active:scale-[0.99] transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-brand-red focus:ring-offset-2 focus:ring-offset-dark-900 cursor-pointer shadow-md"
      >
        <ArrowLeft class="w-4.5 h-4.5" />
        <span>Volver al inicio</span>
      </a>
    </div>
  </main>
</Layout>
