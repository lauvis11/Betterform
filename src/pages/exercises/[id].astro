---
import Layout from "../../layout/Layout.astro";
import ejercicios from "../../data/ejercicios.json";
import type { Exercise } from "../../types/exercise";
import { ArrowLeft, Bookmark, Play, Video, ExternalLink } from 'lucide-astro';
import youtubeIcon from '../../assets/icons/youtube-svgrepo-com.svg';

export function getStaticPaths() {
  return (ejercicios as Exercise[]).map((exercise) => ({
    params: { id: exercise.id },
    props: { exercise },
  }));
}

interface Props {
  exercise: Exercise;
}

const { exercise } = Astro.props;
---

<Layout>
  <main class="w-full min-h-screen bg-dark-900 text-white">
    <div class="w-full max-w-180 mx-auto px-4 py-8 sm:py-10">
      <!-- 1. Botón de navegación volver atrás e ID técnico (Stitch) -->
      <div class="flex items-center justify-between mb-6">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-medium text-neutral-400 hover:text-white transition-colors group cursor-pointer"
        >
          <ArrowLeft class="w-4 h-4 text-neutral-400 group-hover:text-white group-hover:-translate-x-0.5 transition-transform" />
          <span>Volver a resultados</span>
        </a>
        <span class="font-mono text-[11px] sm:text-xs text-neutral-500 uppercase tracking-wider select-none">
          ID: EX-{exercise.id} // CINEMÁTICA
        </span>
      </div>

      <!-- 2. Cabecera y Nombre del Ejercicio con botón de Guardar (Stitch) -->
      <div class="flex items-start justify-between gap-4 mb-3">
        <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
          {exercise.name}
        </h1>
        <button
          id="save-btn"
          data-exercise-id={exercise.id}
          aria-label="Guardar ejercicio"
          class="flex items-center justify-center w-10 h-10 rounded-lg bg-dark-800 border border-dark-700 text-neutral-400 hover:text-white hover:bg-dark-700 hover:border-neutral-500 transition-all cursor-pointer shrink-0 active:scale-95"
          type="button"
          title="Guardar ejercicio"
        >
          <Bookmark class="w-5 h-5 transition-transform" id="save-icon" />
        </button>
      </div>

      <!-- 3. Chips de Metadata (Stitch) -->
      <div class="flex flex-wrap items-center gap-2 mb-6">
        <span class="inline-flex items-center px-3 py-1 rounded-lg bg-dark-800 border border-dark-700 text-xs font-medium text-neutral-300">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-red mr-1.5 shrink-0"></span>
          {exercise.body_part}
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-lg bg-dark-800 border border-dark-700 text-xs font-medium text-neutral-300 capitalize">
          {exercise.equipment}
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-lg bg-dark-800 border border-dark-700 text-xs font-medium text-neutral-300">
          {exercise.category} {exercise.movement_pattern ? `• ${exercise.movement_pattern}` : ''}
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-lg bg-dark-800 border border-dark-700 text-xs font-medium text-neutral-400">
          Nivel: {exercise.level || 'Intermedio'}
        </span>
      </div>

      <!-- 4. Video Container 16:9 (Stitch) -->
      <div 
        id="video-player-container"
        data-video-url={exercise.video_url}
        class="relative w-full aspect-video rounded-xl overflow-hidden bg-dark-950 border border-dark-700 group shadow-2xl"
      >
        <!-- Overlay de previsualización cinemática Stitch -->
        <div id="video-preview-overlay" class="absolute inset-0 flex flex-col justify-between cursor-pointer">
          <div class="absolute inset-0 bg-linear-to-br from-dark-900 via-dark-800 to-dark-950"></div>
          <div class="absolute inset-0 bg-black/40 group-hover:bg-black/25 transition-colors"></div>

          <!-- Top Overlay: Video Format Specification -->
          <div class="relative z-10 p-3 flex justify-end">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-dark-950/80 border border-dark-700/60 text-neutral-400 font-mono text-[11px] font-semibold">
              <Video class="w-3.5 h-3.5" />
              16:9 Estándar
            </span>
          </div>

          <!-- YouTube Style Play Button Badge Central -->
          <div class="relative z-10 flex items-center justify-center">
            <button
              id="video-play-button"
              type="button"
              aria-label="Reproducir video técnico"
              class="w-16 h-12 rounded-xl bg-dark-950/90 border border-dark-700/80 text-white flex items-center justify-center group-hover:bg-brand-red group-hover:border-brand-red group-hover:scale-105 transition-all shadow-xl cursor-pointer"
            >
              <Play class="w-6 h-6 text-white fill-current ml-0.5" />
            </button>
          </div>

          <!-- Bottom Mini Player Timeline & Controls -->
          <div class="relative z-10 p-3 bg-dark-950/80 border-t border-dark-800/80 flex flex-col gap-2">
            <div class="w-full h-1 bg-dark-700 rounded-full overflow-hidden">
              <div class="w-1/3 h-full bg-brand-red"></div>
            </div>
            <div class="flex items-center justify-between text-xs text-neutral-400 font-mono">
              <div class="flex items-center gap-3">
                <span class="text-white hover:text-brand-red cursor-pointer">▶ Play</span>
                <span class="text-neutral-400">01:42 / 04:58</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="font-mono text-[10px] px-1 bg-dark-800 text-neutral-300 rounded border border-dark-700">1080p HD</span>
                <span class="text-neutral-400">fullscreen</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Contenedor del iframe dinámico -->
        <div id="video-iframe-slot" class="w-full h-full hidden"></div>
      </div>

      <!-- 5. Créditos del Video (Stitch) -->
      <div class="flex items-center justify-between mt-2.5 text-xs text-neutral-400 font-mono">
        <div class="flex items-center gap-1.5">
          <span class="text-neutral-500">Video por</span>
          <a
            href={exercise.channel.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-white hover:text-brand-red font-semibold inline-flex items-center gap-1.5 transition-colors group"
          >
            <img
              src={youtubeIcon.src}
              alt="YouTube"
              class="w-4 h-4 object-contain brightness-0 invert opacity-90 inline-block group-hover:opacity-100"
            />
            <span class="underline underline-offset-4">{exercise.channel.name}</span>
            <ExternalLink class="w-3.5 h-3.5 text-neutral-500 group-hover:text-brand-red" />
          </a>
        </div>
        <span class="text-neutral-500 uppercase tracking-wider text-[11px] hidden sm:inline">
          Cues Biomecánicos Verificados
        </span>
      </div>

      <!-- 6. Caja de instrucciones de técnica y músculos secundarios (debajo del video) -->
      <div class="mt-8 bg-dark-800 border border-dark-700 rounded-xl p-6 sm:p-8 shadow-xl">
        <h2 class="text-lg sm:text-xl font-bold mb-3 text-white">Instrucciones de técnica</h2>
        <p class="text-neutral-300 leading-relaxed text-sm sm:text-base">{exercise.instructions}</p>

        {exercise.secondary_muscles && exercise.secondary_muscles.length > 0 && (
          <div class="mt-6 pt-6 border-t border-dark-700">
            <span class="text-xs uppercase tracking-wider font-semibold text-neutral-400 block mb-2">
              Músculos secundarios involucrados:
            </span>
            <div class="flex flex-wrap gap-2">
              {exercise.secondary_muscles.map((muscle) => (
                <span class="px-2.5 py-1 rounded bg-dark-700/60 border border-dark-600 text-xs text-neutral-300 capitalize">
                  {muscle}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Guardar en Favoritos
    const saveBtn = document.getElementById('save-btn');
    const saveIcon = document.getElementById('save-icon');
    const exerciseId = saveBtn?.getAttribute('data-exercise-id');

    if (saveBtn && exerciseId) {
      const STORAGE_KEY = 'betterform_saved_exercises';
      const getSaved = () => {
        try {
          return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        } catch {
          return [];
        }
      };

      let savedList = getSaved();
      let isSaved = savedList.includes(exerciseId);

      const updateUI = () => {
        if (isSaved) {
          saveBtn.classList.add('text-brand-red', 'border-brand-red/50', 'bg-brand-red/10');
          saveBtn.classList.remove('text-neutral-400', 'border-dark-700');
          saveIcon?.setAttribute('fill', 'currentColor');
        } else {
          saveBtn.classList.remove('text-brand-red', 'border-brand-red/50', 'bg-brand-red/10');
          saveBtn.classList.add('text-neutral-400', 'border-dark-700');
          saveIcon?.removeAttribute('fill');
        }
      };

      updateUI();

      saveBtn.addEventListener('click', () => {
        savedList = getSaved();
        if (isSaved) {
          savedList = savedList.filter((id: string) => id !== exerciseId);
          isSaved = false;
        } else {
          savedList.push(exerciseId);
          isSaved = true;
        }
        localStorage.setItem(STORAGE_KEY, JSON.stringify(savedList));
        updateUI();
      });
    }

    // 2. Reproductor de Video Facade -> Embed Iframe
    const videoContainer = document.getElementById('video-player-container');
    const previewOverlay = document.getElementById('video-preview-overlay');
    const iframeSlot = document.getElementById('video-iframe-slot');

    if (videoContainer && previewOverlay && iframeSlot) {
      const videoUrl = videoContainer.getAttribute('data-video-url');

      const launchVideo = () => {
        if (!videoUrl) return;
        const separator = videoUrl.includes('?') ? '&' : '?';
        const autoplayUrl = `${videoUrl}${separator}autoplay=1&rel=0`;

        iframeSlot.innerHTML = `
          <iframe 
            src="${autoplayUrl}" 
            title="Video instructivo de técnica"
            class="w-full h-full border-0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            allowfullscreen
          ></iframe>
        `;
        previewOverlay.classList.add('hidden');
        iframeSlot.classList.remove('hidden');
      };

      videoContainer.addEventListener('click', launchVideo, { once: true });
    }
  });
</script>